#version 450

// Flash-Next RX 570 expert tier, gate/up stage.
//
// Math mirrors expert_cpu.cpp's flash_next_cold_experts: FP32 accumulation, exact NVFP4 decode,
// SiLU(g)*u rounded to BF16 before the down stage.

const uint kHidden       = 2560u;
const uint kIntermediate = 640u;
const uint kMaxJobs      = 10u;
const uint kMaxTokens    = 8u;

layout(constant_id = 0) const uint kGateCodeWords  = 1u;
layout(constant_id = 1) const uint kGateScaleWords = 1u;
layout(constant_id = 2) const uint kDownCodeWords  = 1u;
layout(constant_id = 3) const uint kDownScaleWords = 1u;

uint align_words(uint w) { return (w + 63u) & ~63u; } // 256 bytes = 64 words
uint gate_codes_word0()  { return 0u; }
uint gate_scales_word0() { return align_words(kGateCodeWords); }
uint gate_div_word0()    { return gate_scales_word0() + align_words(kGateScaleWords); }
uint down_codes_word0()  { return gate_div_word0() + 64u; }
uint down_scales_word0() { return down_codes_word0() + align_words(kDownCodeWords); }
uint down_div_word0()    { return down_scales_word0() + align_words(kDownScaleWords); }
uint packed_words()      { return down_div_word0() + 64u; }

layout(std430, set = 0, binding = 0) readonly buffer SlotPool { uint data[]; } slot_pool;
layout(std430, set = 0, binding = 1) readonly buffer XBuf { float x[]; } xbuf;
layout(std430, set = 0, binding = 2) readonly buffer JobsBuf { uint data[]; } jobs_buf;
layout(std430, set = 0, binding = 3) buffer ActBuf { float act[]; } act_buf;
layout(std430, set = 0, binding = 4) buffer OutBuf { float out_data[]; } outbuf;

// Job table, flat uint words per job: slot, count, tokens[8], weights[8] (float bits).
const uint kJobWords = 2u + 2u * kMaxTokens;
uint job_slot(uint j) { return jobs_buf.data[j * kJobWords + 0u]; }
uint job_count(uint j) { return jobs_buf.data[j * kJobWords + 1u]; }
uint job_token(uint j, uint k) { return jobs_buf.data[j * kJobWords + 2u + k]; }
float job_weight(uint j, uint k) { return uintBitsToFloat(jobs_buf.data[j * kJobWords + 2u + kMaxTokens + k]); }

// Exact NVFP4 decode by float bit construction (Polaris has no FP16/FP4/FP8 conversions).
float e2m1_decode(uint n) {
    uint e = (n >> 1u) & 3u;
    uint m = n & 1u;
    float v = e == 0u ? 0.5 * float(m) : uintBitsToFloat(((e + 126u) << 23u) | (m << 22u));
    return (n & 8u) != 0u ? -v : v;
}

float e4m3_decode(uint b) {
    uint e = (b >> 3u) & 0xFu;
    uint m = b & 7u;
    float v = e == 0u ? float(m) * (1.0 / 512.0) : uintBitsToFloat(((e + 120u) << 23u) | (m << 20u));
    return (b & 0x80u) != 0u ? -v : v;
}

// Swizzled E4M3 scale byte offset (storage-layouts.md section 4; expert_cpu.cpp scale_offset()).
uint scale_offset(uint row, uint group, uint columns) {
    uint row_inner = row % 128u;
    return ((row / 128u) * (columns / 64u) + group / 4u) * 512u + (row_inner % 32u) * 16u +
           (row_inner / 32u) * 4u + group % 4u;
}

// Decodes code word `w` (8 weights, columns 8w..8w+7) of a row, times its group scale.
void decode_word(uint word, float scale, out float v[8]) {
    for (uint j = 0u; j < 4u; ++j) {
        uint byte = (word >> (8u * j)) & 0xFFu;
        v[2u * j]      = e2m1_decode(byte & 0xFu) * scale;
        v[2u * j + 1u] = e2m1_decode(byte >> 4u) * scale;
    }
}

// One 64-thread workgroup per (job, gate/up pair): lane l owns code words l + 64 i (i < 5) of the
// gate row and of the up row, so a wave reads each 1280-byte row fully coalesced. The weights are
// decoded once into registers and reused for every token of the job; the per-token partial dots are
// reduced through shared memory.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint kRowWords = kHidden / 8u; // 320 code words per row
const uint kPerLane  = kRowWords / 64u; // 5

shared float red[2u * kMaxTokens][64];
shared float sums[2u * kMaxTokens];

float bf16_round(float v) {
    uint bits = floatBitsToUint(v);
    bits += 0x7FFFu + ((bits >> 16u) & 1u);
    return uintBitsToFloat(bits & 0xFFFF0000u);
}

void main() {
    uint job   = gl_WorkGroupID.x;
    uint pair  = gl_WorkGroupID.y;
    uint lane  = gl_LocalInvocationID.x;
    uint count = job_count(job);
    if (count == 0u) { return; }

    uint base = job_slot(job) * packed_words();
    float wg[kPerLane][8];
    float wu[kPerLane][8];
    for (uint i = 0u; i < kPerLane; ++i) {
        uint w = lane + 64u * i;
        for (uint r = 0u; r < 2u; ++r) {
            uint row        = r == 0u ? pair : kIntermediate + pair;
            uint code       = slot_pool.data[base + gate_codes_word0() + row * kRowWords + w];
            uint sbyte      = scale_offset(row, w / 2u, kHidden);
            uint sword      = slot_pool.data[base + gate_scales_word0() + sbyte / 4u];
            float scale     = e4m3_decode((sword >> (8u * (sbyte & 3u))) & 0xFFu);
            float v[8];
            decode_word(code, scale, v);
            for (uint j = 0u; j < 8u; ++j) {
                if (r == 0u) { wg[i][j] = v[j]; } else { wu[i][j] = v[j]; }
            }
        }
    }
    for (uint k = 0u; k < count; ++k) {
        uint xoff = job_token(job, k) * kHidden;
        float g = 0.0, u = 0.0;
        for (uint i = 0u; i < kPerLane; ++i) {
            uint c0 = xoff + (lane + 64u * i) * 8u;
            for (uint j = 0u; j < 8u; ++j) {
                float xv = xbuf.x[c0 + j];
                g = fma(wg[i][j], xv, g);
                u = fma(wu[i][j], xv, u);
            }
        }
        red[2u * k][lane]      = g;
        red[2u * k + 1u][lane] = u;
    }
    barrier();
    if (lane < 2u * count) {
        float s = 0.0;
        for (uint l = 0u; l < 64u; ++l) { s += red[lane][l]; }
        sums[lane] = s / uintBitsToFloat(slot_pool.data[base + gate_div_word0()]);
    }
    barrier();
    if (lane < count) {
        float g = sums[2u * lane];
        float u = sums[2u * lane + 1u];
        act_buf.act[(job * kMaxTokens + lane) * kIntermediate + pair] = bf16_round(g / (1.0 + exp(-g)) * u);
    }
}
